# Medora environment contract — validated at boot by src/configs/env.ts.
# Copy to .env (git-ignored) for local overrides. Only VITE_-prefixed
# variables reach the client; never put secrets here.
#
# For the hosted deployment these are set in the Vercel dashboard, not in
# a committed file — see DEPLOYMENT.md for the production values and the
# backend CORS/cookie requirements that come with them.
#
# A build with no .env at all still boots, against the real API at the
# default VITE_API_BASE_URL. VITE_ENABLE_MOCKS is the one variable with no
# default: mocks are opt-in, so copy this file to develop against the
# seeded mock backend instead.

# Base URL of the Medora API, INCLUDING the /api/v1 prefix (backend
# ADR-011). The refresh cookie is scoped Path=/api/v1/auth, so a base URL
# missing the version means the browser never sends it and silent refresh
# fails silently.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# development | staging | production
VITE_APP_ENV=development

# true  → the seeded mock backend (features/auth/mock/, doctor@medora.health)
# false, or absent → the live API at VITE_API_BASE_URL
# Read in exactly one place: `selectService` in src/api/seam.ts.
#
# Never `true` with VITE_APP_ENV=production — that combination is refused at
# boot by `resolveEnableMocks` in src/configs/env.ts, because the mock
# backend accepts seeded credentials and never reaches the API.
VITE_ENABLE_MOCKS=true
