{
  "name": "medora-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Medora — AI-powered healthcare management platform (backend API)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:safety": "vitest run --coverage --coverage.include='src/modules/pharmacy/services/safety-screen.ts' --coverage.thresholds.100 src/modules/pharmacy/services/safety-screen.spec.ts",
    "test:labs-safety": "vitest run --coverage --coverage.include='src/modules/labs/services/result-grading.ts' --coverage.include='src/modules/labs/services/lab-review.ts' --coverage.include='src/modules/labs/services/specimen-condition.ts' --coverage.include='src/modules/labs/services/lab-status.machine.ts' --coverage.thresholds.100 src/modules/labs",
    "test:appointments-safety": "vitest run --coverage --coverage.include='src/modules/appointments/services/appointment-status.machine.ts' --coverage.thresholds.100 src/modules/appointments/services/appointment-status.machine.spec.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "demo:totp": "tsx prisma/demo-totp.ts",
    "admin:bootstrap": "node dist/cli/bootstrap-admin.js",
    "openapi:generate": "nest build && node dist/cli/openapi-generate.js",
    "openapi:check": "nest build && node dist/cli/openapi-generate.js --check",
    "crypto:reencrypt": "node dist/cli/reencrypt-envelopes.js",
    "db:reset": "prisma migrate reset --force",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema --exit-code"
  },
  "comment:overrides": "The stack is fixed at NestJS 10 (roadmap header). Nest 10's transitive express/multer chain carries published advisories whose npm-suggested fix is NestJS 11 — a stack change requiring an ADR. These overrides pull the patched transitives forward while keeping Nest 10. Re-audited at M37.1 (2026-10-24): all five raised to their patched releases and proxy-addr added (critical IPv4-mapped spoofing, GHSA via express 4). Drop any override that upstream has caught up with.",
  "overrides": {
    "qs": "^6.16.1",
    "multer": "^2.5.0",
    "express": "^4.22.3",
    "body-parser": "^1.20.9",
    "file-type": "^22.0.1",
    "proxy-addr": "^2.0.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.3.8",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.10.7",
    "@types/compression": "^1.8.1",
    "@types/cookiejar": "^2.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cookiejar": "^2.1.4",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.1.10"
  }
}
