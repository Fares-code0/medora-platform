# Medora backend environment contract.
# Copy to .env for local overrides. NEVER commit a filled-in .env —
# .gitignore already excludes it. Secrets are injected, not stored (MG §11.10).
#
# Since M3.1 this file is backed by a Zod schema (`src/config/env.schema.ts`)
# that runs before the application starts: a missing or malformed variable
# stops the boot and names the variable. `src/config/env.spec.ts` parses this
# very file against that schema, so the two cannot drift apart.
#
# `.env` never overrides a variable already set in the environment — in a
# container the orchestrator wins, so a stale `.env` baked into an image
# cannot quietly take precedence.
#
# Values marked (default) may be omitted entirely; the schema supplies them.
# Everything else is required and has no safe default.

# ── Runtime ────────────────────────────────────────────────────────────
APP_ENV=development           # development | test | staging | production
PORT=3000                     # (default)
LOG_LEVEL=debug               # (default: debug in development, info elsewhere)

# Comma-separated exact origins. A wildcard is invalid with credentialed
# CORS, which the httpOnly refresh cookie requires. 5173 is Vite's default.
# Rejected in production if it contains localhost.
CORS_ORIGINS=http://localhost:5173

# ── Datastores (M4, M31) ───────────────────────────────────────────────
DATABASE_URL=postgresql://medora:medora@localhost:5432/medora?schema=public
REDIS_URL=redis://localhost:6379

# Prisma CLI only — never read by the application, so it is deliberately
# absent from the Zod contract. `migrate dev` and `npm run db:check`
# replay migration history here to detect drift; keeping it off the
# working database means a check can never touch real data.
SHADOW_DATABASE_URL=postgresql://medora:medora@localhost:5432/medora_shadow?schema=public

# ── Object storage (M25) — MinIO in dev, S3 in production ──────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=medora-files
S3_ACCESS_KEY_ID=medora
S3_SECRET_ACCESS_KEY=medora-dev-secret   # placeholder; rejected in production
S3_FORCE_PATH_STYLE=true      # (default) MinIO needs it; real S3 does not

# ── Auth (M6) ──────────────────────────────────────────────────────────
# Generate per environment: openssl rand -base64 48
# Minimum 32 characters. The placeholder below is rejected in production.
JWT_SECRET=replace-me-with-a-generated-secret
JWT_ACCESS_TTL=900            # (default) seconds — 900 is the ceiling, MG §11.1-1
REFRESH_TTL_REMEMBER=2592000  # (default) 30 days  (API §1.2)
REFRESH_TTL_DEFAULT=43200     # (default) 12 hours (API §1.2)
COOKIE_DOMAIN=localhost       # rejected in production

# Where the WEB APP is served. Verification and reset emails link to its
# routes (/verify-email?token=…, /reset-password?token=…), so this is the
# frontend's address, not the API's. Rejected in production if it is localhost.
APP_PUBLIC_URL=http://localhost:5173

# Envelope key for encryption at rest (M6.4 — the TOTP secret and recovery
# codes). Base64 for exactly 32 bytes: openssl rand -base64 32
# Separate from JWT_SECRET so signing keys can be rotated without making
# every stored second factor undecryptable. Rejected in production.
DATA_ENCRYPTION_KEY=cmVwbGFjZS1tZS13aXRoLW9wZW5zc2wtcmFuZC1iNjQ=
# Retired envelope keys that may still decrypt, never encrypt — set only
# while rotating DATA_ENCRYPTION_KEY (docs/PRODUCTION_SETUP.md §2).
# Comma-separated, base64 for 32 bytes each. Empty is the normal state.
DATA_ENCRYPTION_KEY_PREVIOUS=
# The envelope layout this instance writes: legacy (default — readable by
# every earlier build, so rolling deploys and rollbacks stay safe) or keyed.
# Both are always read. Set keyed only once no older build will run again.
DATA_ENCRYPTION_WRITE_FORMAT=legacy

# ── Mail (M19) — mailhog in dev, no auth ───────────────────────────────
# `docker compose up -d mailhog` serves SMTP on 1025 and the inbox at
# http://localhost:8025. SMTP_HOST is a bare hostname — the port goes in
# SMTP_PORT, and `localhost:1025` here is refused at boot.
#   API on the host (`npm run dev`, the default): SMTP_HOST=localhost
#   API inside the compose network:               SMTP_HOST=mailhog
# Delivery failures do not fail the request — registration still answers
# 201 — so if no mail arrives, look for "Mail delivery failed" in the log.
SMTP_HOST=localhost
SMTP_PORT=1025                # (default)
SMTP_USER=                    # required in production
SMTP_PASSWORD=
SMTP_FROM="Medora <no-reply@medora.health>"

# ── Malware scanning (M25.3) ─────────────────────────────────────────
# The clamd daemon uploads are streamed to (INSTREAM). Unset, no engine is
# bound: every upload stays `pending` and cannot be downloaded — the scan
# gate working, not broken. clamd's StreamMaxLength must be at least the
# largest upload limit (25 MB). See docs/EXTERNAL_INTEGRATIONS.md.
CLAMAV_HOST=                            # (default) unset — no scanning
CLAMAV_PORT=3310                        # (default)
CLAMAV_TIMEOUT_MS=30000                 # (default) per file, connection to verdict
# ── SMS (M19) — stub until a provider is chosen ────────────────────────
SMS_PROVIDER=stub             # (default)
SMS_API_KEY=

# ── AI provider (M16) — the AiGateway is the only consumer ─────────────
# Optional throughout. /health reports `ai: unconfigured` until both are set.
AI_PROVIDER=
AI_API_KEY=

# ── Security policy defaults (M3.3) ────────────────────────────────────
# The environment layer of the policy `PolicyService` resolves. From M24 an
# administrator's platform-settings row overrides any of these at runtime;
# these values are what applies when it has not been edited.
#
# The defaults match the frontend's seeded SecurityPolicySettings exactly
# (features/admin/admin-settings.api.ts) — a backend defaulting differently
# would silently change the policy an administrator already sees.
# ── Communication content-access policy (ADR-006, M20.7) ───────────────
# Second-admin approval for reading message content. The project owner
# decided self-serve plus a complete audit trail on 2026-08-12 and
# required the flow stay policy-driven, so both modes are built.
COMMUNICATION_REQUIRE_SECOND_ADMIN_APPROVAL=false   # (default)
# How long a content-access grant stays active, in minutes.
# DELIBERATELY UNSET. ADR-006 §4 requires grants to expire and RA-006.3
# records that no source gives a duration — the 15-minute PHI-reveal
# window is named only as a precedent, and whether it suits message
# content is an open product question. The grant endpoint fails closed
# (503) until a deployment sets this, rather than the platform guessing
# its most privacy-sensitive timeout.
COMMUNICATION_GRANT_TTL_MINUTES=

SECURITY_TWO_FACTOR_REQUIRED=false      # (default)
SECURITY_PASSWORD_EXPIRY_DAYS=180       # (default)
SECURITY_SESSION_TIMEOUT_MINUTES=30     # (default) idle timeout
SECURITY_LOGIN_ATTEMPT_LIMIT=5          # (default) lockout counter, MG §11.1-8
SECURITY_SINGLE_SESSION_PER_USER=false  # (default)
# No upstream source states a lockout DURATION — only the attempt count
# above. This is a backend default (ADR-025), layered like the rest so an
# administrator field can override it the day one exists.
SECURITY_LOCKOUT_MINUTES=15             # (default)

# ── Platform mode (M24.6) ─────────────────────────────────────────────
# The env layer under the `general` platform-settings slice's
# maintenance flag. An administrator turning maintenance on in the panel
# overrides these; they decide what applies before any settings row is
# read. The middleware that serves 503 is M38.3.
MAINTENANCE_MODE=false                  # (default)
MAINTENANCE_MESSAGE=                    # (default: empty)

# ── Retention (M28.5) ─────────────────────────────────────────────────
# The env layer under the `retention` settings slice's audit window,
# which M28.5's partition sweep enforces. ADR-007 R1's established value.
RETENTION_AUDIT_LOG_DAYS=365            # (default)

# ── Background jobs (M30.1) ───────────────────────────────────────────
# `JOBS_ENABLED` decides whether THIS instance fires the eleven
# registered schedules. It never suppresses registration: the registry is
# built, sealed and printed at boot either way, and
# `GET /administration/jobs` lists it. Turn it off on a replica that
# serves requests while a dedicated worker owns the sweeps.
JOBS_ENABLED=true                       # (default)
# `inline` keeps the schedules on this process's own timers. `bullmq`
# hands them to Redis (REDIS_URL above) so that N replicas fire each
# schedule once — set it as soon as there is more than one instance.
JOBS_DRIVER=inline                      # (default) inline | bullmq
# How often EVERY instance clears lapsed encrypted refresh-token successors
# (ADR-045, RA-045.2). Independent of JOBS_ENABLED / JOBS_DRIVER on
# purpose: it bounds how long a live refresh token sits encrypted at rest
# (about 30 s + this interval), so it runs even where jobs are off and
# cannot be disabled. 5–60 seconds.
REFRESH_SUCCESSOR_SWEEP_INTERVAL_SECONDS=30   # (default)

# ── Client address and rate limiting (M37.2) ──────────────────────────
# Which proxy hops' X-Forwarded-For the API believes. Empty trusts none:
# req.ip is the TCP peer. Set it from the deployment's real topology —
# a hop count (1 = one load balancer that overwrites the header) or the
# proxies' addresses/CIDRs, e.g. 10.0.0.0/8 or loopback. `true` is
# refused: it would let any client choose its own address.
# See docs/RATE_LIMITING.md. PENDING deployment-proxy verification.
TRUST_PROXY=                            # (default) trust nothing
# Per-client limit on the public credential routes (login, OTP,
# registration, recovery, verification, invitation acceptance). Off by
# default until TRUST_PROXY is verified: behind an untrusted proxy every
# client shares one address, and one limit would throttle everyone.
RATE_LIMIT_ENABLED=false                # (default)
RATE_LIMIT_AUTH_MAX=20                  # (default) requests per window, per client address
RATE_LIMIT_AUTH_WINDOW_SECONDS=60       # (default)

# ── Phase 22 hospital scope (shadow mode) ─────────────────────────────
# Computes the hospital-aware patient-scope decision next to the legacy
# one and logs divergence. Observation only — never grants or refuses
# access. Opt-in: off by default, which removes the comparison and its
# queries entirely. Do not enable under real load until shadow queries are
# bounded (statement timeout / in-flight cap, condition C1): they share the
# application's connection pool and have no enforced timeout.
HOSPITAL_SCOPE_SHADOW_COMPARISON=false  # (default) true|1 enables, false|0 disables
# Multi-hospital §2.15: open every database transaction with the request's
# transaction-local tenant context for Row-Level Security. Required in
# production (the service must connect as the non-owner runtime role from
# prisma/roles/provision-runtime-role.sql); harmless but unnecessary for an
# owner connection, which RLS does not bind.
DATABASE_TENANT_CONTEXT=false  # (default) true|1 enables, false|0 disables
# C1 bounds, applied whenever the comparison is on. At the in-flight cap a
# comparison is skipped, never queued, and never delays a decision. The
# statement timeout is transaction-local to the shadow's own query.
HOSPITAL_SCOPE_SHADOW_MAX_IN_FLIGHT=4             # (default) 1–8 per process
HOSPITAL_SCOPE_SHADOW_STATEMENT_TIMEOUT_MS=250    # (default) 10–5000

# ── Metrics (M38.1) ───────────────────────────────────────────────────
# Bearer token for GET /api/v1/metrics (Prometheus text format). Unset,
# the endpoint answers 404. Generate with `openssl rand -base64 48` and
# give it only to the scraper. See docs/EXTERNAL_INTEGRATIONS.md.
METRICS_TOKEN=                          # (default) unset — endpoint off
