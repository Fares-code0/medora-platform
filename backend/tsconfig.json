{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2023"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    /* NestJS requires both — DI metadata is emitted from decorators. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Strictness — mirrors frontend/tsconfig.app.json (RM M1.1).
       The frontend's bundler-only flags (jsx, allowImportingTsExtensions,
       noEmit) are deliberately absent; everything that expresses type
       strictness is matched exactly. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Nest emits classes whose properties are assigned by the DI container. */
    "strictPropertyInitialization": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "paths": {
    "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vitest.config.ts",
    "prisma.config.ts",
    "prisma/**/*.ts",
    "perf/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
